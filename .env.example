# ---------------------------------------------------------------- core
NODE_ENV=production
PORT=8787
# Public address admins and tenants open (signing links in WhatsApp use it).
PUBLIC_URL=https://kos.example.com
APP_TIMEZONE=Asia/Jakarta

# Postgres password for docker-compose (also used in DATABASE_URL below).
POSTGRES_PASSWORD=ganti-dengan-password-panjang-acak
DATABASE_URL=postgres://kosku:ganti-dengan-password-panjang-acak@db:5432/kosku

# Username of the first superadmin created on an empty database.
# Its temporary password is printed once in the app log: docker compose logs app
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=Pemilik
# Opsional: buat akun developer (sandbox data dummy, tanpa akses data asli) saat boot pertama.
# Di production lebih baik lewat CLI: node dist-server/cli.js create-developer <username>
# INITIAL_DEVELOPER_USERNAME=developer
# Batas percobaan login per IP per 15 menit (naikkan hanya untuk smoke test lokal, mis. 500).
# LOGIN_IP_LIMIT=20

# Behind Caddy or Cloudflare Tunnel: trust the forwarded client IP.
TRUST_PROXY=true
SESSION_IDLE_HOURS=72
SESSION_MAX_DAYS=30

# ---------------------------------------------------------------- WhatsApp
# baileys = link a real number by scanning a QR; mock = simulate (for trials)
WA_DRIVER=baileys
# Pause between outgoing messages (anti-ban pacing)
WA_MIN_DELAY_MS=4000
WA_MAX_DELAY_MS=9000

# ---------------------------------------------------------------- files
# local = Docker volume (backed up by the backup service); s3 = R2/S3 bucket
STORAGE_DRIVER=local
UPLOAD_MAX_MB=10
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=kosku-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- monitoring
# healthchecks.io ping URL, hit after every successful nightly billing run.
# If a night is missed, healthchecks.io alerts you (dead-man's switch).
HEALTHCHECK_URL=

# ---------------------------------------------------------------- backups (backup service)
# Rclone remote for off-site backups, configured via env (Cloudflare R2 example):
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_REMOTE=r2:kosku-backup
# Backups are encrypted with this age public key before leaving the server.
# Generate a pair with:  age-keygen -o kosku-backup.key   (keep the .key file OFF the server)
BACKUP_AGE_RECIPIENT=age1...

# ---------------------------------------------------------------- Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=
# Caddy (optional, when not using the tunnel): domain for automatic HTTPS
DOMAIN=kos.example.com
