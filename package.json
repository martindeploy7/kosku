{
  "name": "kosku",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,api,web -c gray,blue,magenta \"npm:dev:db\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && tsup",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "start": "node dist-server/index.js",
    "cli": "node dist-server/cli.js",
    "cli:dev": "tsx --env-file=.env.development server/cli.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@hono/node-server": "^2.1.1",
    "@node-rs/argon2": "^2.2.1",
    "baileys": "^7.0.0-rc14",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.3",
    "file-type": "^22.1.1",
    "hono": "^4.13.9",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "pdfkit": "^0.20.2",
    "pg-boss": "^12.34.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/node": "^26.6.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.10.0-beta.17",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "baileys": false,
    "core-js": false,
    "protobufjs": false
  },
  "engines": {
    "node": ">=22.12"
  }
}
